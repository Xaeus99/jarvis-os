# Which published image the installer ISO (build-iso workflow) and the dual-boot install test (install-test
# workflow) are built from. A tag (beta, stable), or a tag pinned to one exact image: beta@sha256:<digest>.
# The tag part is what installed systems follow for updates; a pinned digest only chooses what goes in the ISO.
IMAGE_REF=beta@sha256:2aa3ea314f7b2a0ba6f439932058cd0cff6a25511f8632eedc852524230f8de4
# yes = after the ISO boots to the installer in a VM, publish it as a GitHub Release, split into parts under 2 GiB
# (beta = pre-release; stable = the release the "latest" link points to).
PUBLISH=yes
# Release tag (optional). A -rc tag is published as a pre-release (never "latest"); release candidate 1 of 1.0 follows
# the beta channel (rc1 Oct 16, rc2 + rc3 Oct 22, rc4 Oct 23, rc5 Oct 28: VR bridge + Bazzite 44.20261026; rc5 gate re-run on D22 with the unpair fix; rc6 Oct 29: PAIR VR button,
# VR CGNAT option, web-app launchers; rc7 Oct 30: yes/no questions answered, CGNAT by voice, spoken web search, Fly Vault).
# An existing release is never changed.
RELEASE_TAG=v1.0.0-rc7
