# Which published image the installer ISO (build-iso workflow) and the dual-boot install test (install-test
# workflow) are built from. A tag (beta, stable), or a tag pinned to one exact image: beta@sha256:<digest>.
# The tag part is what installed systems follow for updates; a pinned digest only chooses what goes in the ISO.
IMAGE_REF=beta@sha256:b44d21f5c8ba785d0393f5307e27808bcc33db8d549cec075394d96ba09a2bf3
# yes = after the ISO boots to the installer in a VM, publish it as a GitHub Release, split into parts under 2 GiB
# (beta = pre-release; stable = the release the "latest" link points to).
PUBLISH=no
