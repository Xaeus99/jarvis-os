[Unit]
Description=J.A.R.V.I.S. offline brain (local AI model server, localhost only)
# does nothing until the offline brain has been downloaded (jarvisctl ai setup / jarvis-ai-setup.service)
ConditionPathExists=%h/.local/share/jarvis/ollama/bin/ollama
After=graphical-session.target

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=%h/.local/share/jarvis/ollama/models
Environment=OLLAMA_KEEP_ALIVE=30m
Environment=OLLAMA_NO_CLOUD=1
ExecStart=%h/.local/share/jarvis/ollama/bin/ollama serve
Restart=on-failure
RestartSec=15
Nice=5

[Install]
WantedBy=graphical-session.target
