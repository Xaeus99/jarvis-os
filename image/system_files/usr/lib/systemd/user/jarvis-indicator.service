[Unit]
Description=J.A.R.V.I.S. "Tab is driving" indicator and kill switch
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/usr/lib/jarvis-os
ExecStart=/usr/lib/jarvis-os/venv/bin/python -m jarvisd.indicator
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
