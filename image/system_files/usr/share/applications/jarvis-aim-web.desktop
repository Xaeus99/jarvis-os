[Desktop Entry]
Type=Application
Name=J.A.R.V.I.S. Aim Trainer
Comment=Open the JARVIS aim trainer with its on-device coach (mouse or Quest) in the browser
Exec=xdg-open https://jarvis-aim.sites.tab.bot/
Icon=jarvis-aim-web
Categories=Game;
Keywords=jarvis;aim;trainer;fps;practice;
StartupNotify=false
# JARVIS OS 1.0.0-rc6: a launcher for one of JARVIS's web apps (they also work on a PC with mouse and keyboard)
