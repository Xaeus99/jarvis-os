# JARVIS OS image: Bazzite (KDE, NVIDIA open kernel modules for RTX 50-series) + the JARVIS layer.
# Built by .github/workflows/build.yml, pushed to ghcr.io/${REPO_ORG}/jarvis-os and signed with cosign.
# Install: the ISO from disk_config/iso.toml, or `sudo bootc switch ghcr.io/<org>/jarvis-os:stable` from Bazzite.

# Pinned base (bumped after a green test run). Rebased Oct 22 2026 (JARVIS OS 1.0.0-rc2):
# ghcr.io/ublue-os/bazzite-nvidia-open:stable = 44.20261012.1, kernel 7.2.9-ogc3.1.fc44 (built 2026-10-13,
# upstream revision 2fab72c). Previous pin (rc1): 44.20261006.1, kernel 7.2.8, sha256:fe770170e272...
# (an ARG used in FROM must come before the first FROM)
ARG BASE_IMAGE=ghcr.io/ublue-os/bazzite-nvidia-open:stable@sha256:ed93d2158a1bcba16b226bfb3ab6391446d11466646188c800b982d709435151

FROM scratch AS ctx
COPY build_files /
COPY system_files /system_files
COPY jarvisd /jarvisd
COPY cosign.pub /cosign.pub

FROM ${BASE_IMAGE}

ARG JARVIS_OS_VERSION=0.1.0
ARG IMAGE_REPO=ghcr.io/example/jarvis-os
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    JARVIS_OS_VERSION=${JARVIS_OS_VERSION} IMAGE_REPO=${IMAGE_REPO} /ctx/build.sh

LABEL org.opencontainers.image.title="JARVIS OS" \
      org.opencontainers.image.description="J.A.R.V.I.S. desktop on Bazzite: KDE Plasma, Steam/Proton, NVIDIA open drivers" \
      containers.bootc="1"

# --fatal-warnings: rc2 cleared the last two warnings (dnf state in /var and /run), so any new one fails the build
RUN bootc container lint --fatal-warnings
